# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# AI Integration
GEMINI_API_KEY=MY_GEMINI_API_KEY

# PostgreSQL Connection (Pilih salah satu: DATABASE_URL atau DB_HOST dkk)
# Opsi 1: Connection URL (bisa untuk Neon, Supabase, Railway, atau PostgreSQL lokal)
DATABASE_URL=postgres://postgres:password123@localhost:5432/lokalsite

# Opsi 2: Parameter terpisah (jika DATABASE_URL tidak diisi)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password123
DB_NAME=lokalsite
DB_SSL=false
