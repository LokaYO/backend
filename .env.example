PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

GEMINI_API_KEY=YOURKEY

# PostgreSQL Connection Parameters (Tanpa DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOURPASSWORD
DB_NAME=loka
DB_SSL=false

# Standard PostgreSQL Environment (Untuk node-pg-migrate & CLI tools)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOURPASSWORD
PGDATABASE=loka

# JWT Secret & Expiration
JWT_SECRET=lokalsite_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=1d

# Midtrans Payment Gateway (Sandbox Mode)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=YOURKEY
MIDTRANS_CLIENT_KEY=YOURKEY
